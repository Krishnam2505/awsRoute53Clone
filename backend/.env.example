# SQLite file location. In Docker the volume is mounted at /data.
DATABASE_URL=sqlite:///./route53.db
# Name of the HTTP-only session cookie
SESSION_COOKIE_NAME=r53_session
# Set to false only if you serve the API over plain HTTP on a non-localhost host
SESSION_COOKIE_SECURE=true
SESSION_TTL_DAYS=7
# Only needed when the browser calls the API directly (the Next.js rewrite makes it unnecessary)
CORS_ORIGINS=http://localhost:3000
